{
  "prometheus": {
    "enabled": true,
    "scrape_interval": "30s",
    "metrics_retention": "15d"
  },
  "grafana": {
    "enabled": true,
    "dashboards": [
      "system",
      "application",
      "business"
    ]
  },
  "alerts": {
    "enabled": true,
    "notification_channels": [
      "slack",
      "email",
      "pagerduty"
    ],
    "alert_rules": [
      {
        "name": "high_memory_usage",
        "threshold": 90
      },
      {
        "name": "high_cpu_usage",
        "threshold": 80
      },
      {
        "name": "high_error_rate",
        "threshold": 5
      },
      {
        "name": "slow_response_time",
        "threshold": 2000
      }
    ]
  },
  "logging": {
    "centralized": true,
    "log_level": "INFO",
    "structured": true,
    "retention_days": 30
  }
}